# Conexión RCON al servidor (ver docs/SETUP.md)
RCON_HOST=localhost
RCON_PORT=25575
RCON_PASSWORD=cambia-esto

# Modelo: cualquier cadena de LiteLLM (https://docs.litellm.ai/docs/providers)
# Ejemplos:
#   anthropic/claude-sonnet-5-5   -> requiere ANTHROPIC_API_KEY
#   openai/gpt-5                  -> requiere OPENAI_API_KEY
#   gemini/gemini-2.5-pro         -> requiere GEMINI_API_KEY
#   ollama/llama3.1               -> modelo local, requiere Ollama corriendo
MODEL=anthropic/claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Comandos que el agente nunca podrá ejecutar (separados por coma).
# Una entrada bloquea todo lo que empiece con ella, también dentro de `execute ... run`.
# `easy_npc test` genera decenas de NPCs de prueba; `kill` puede borrar entidades en masa.
BLOCKED_COMMANDS=stop,op,deop,ban,ban-ip,pardon,whitelist,save-off,kill,easy_npc test
# Máximo de comandos por orden
MAX_STEPS=12

# --- Modo escucha (python -m director.listen) ---
# Log del servidor, relativo a la carpeta del agente
LOG_PATH=../server/logs/latest.log
# NPCs que responden cuando un jugador los menciona en el chat (separados por coma)
NPC_NAMES=Bob
# Saludar a los jugadores cuando entran (gasta tokens en cada entrada)
GREET_JOINS=false
